        <https://github.com/semantic-evidence/semantic-evidence/blob/master/ontology/rdo.owl> ;
    rdfs:isDefinedBy spec:core ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource swande:Claim ;
    owl:annotatedTarget rdo:assertion ;
    skos:changeNote "SAGE alignment: a SWAN Claim is also a SEE assertion on the same individual. This subclass axiom is introduced by SAGE, not by either source ontology."@en .

[] a owl:Axiom ;
    dcterms:source <https://example.org/sage/spec>,
        <https://github.com/pav-ontology/swan-ontology/blob/2.0.1/discourse-elements.owl>,
        <https://github.com/semantic-evidence/semantic-evidence/blob/master/ontology/rdo.owl> ;
    rdfs:isDefinedBy spec:core ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource swande:Hypothesis ;
    owl:annotatedTarget rdo:assertion ;
    skos:changeNote "SAGE alignment: a SWAN Hypothesis is also a SEE assertion on the same individual. This subclass axiom is introduced by SAGE, not by either source ontology."@en .

# SWAN discourse relationship hierarchy and symmetry, reused unchanged.
# No domains, ranges, transitivity, or inverse pairs are added.

swandr:relatesTo a owl:ObjectProperty ;
    dcterms:source <https://raw.githubusercontent.com/pav-ontology/swan-ontology/2.0.1/discourse-relationships.owl> ;
    rdfs:isDefinedBy spec:normalization ;
    skos:changeNote "Reused SWAN declaration and structural axioms, without endpoint restrictions."@en .

swandr:refersTo a owl:ObjectProperty ;
    rdfs:subPropertyOf swandr:relatesTo ;
    dcterms:source <https://raw.githubusercontent.com/pav-ontology/swan-ontology/2.0.1/discourse-relationships.owl> ;
    rdfs:isDefinedBy spec:normalization ;
    skos:changeNote "Reused SWAN declaration and structural axioms, without endpoint restrictions."@en .

swandr:referencesAsSupportiveEvidence a owl:ObjectProperty ;
    rdfs:subPropertyOf swandr:refersTo ;
    dcterms:source <https://raw.githubusercontent.com/pav-ontology/swan-ontology/2.0.1/discourse-relationships.owl> ;
    rdfs:isDefinedBy spec:normalization ;
    skos:changeNote "Reused SWAN declaration and structural axioms, without endpoint restrictions."@en .

swandr:referencesAsRelevantEvidence a owl:ObjectProperty ;
    rdfs:subPropertyOf swandr:refersTo ;
    dcterms:source <https://raw.githubusercontent.com/pav-ontology/swan-ontology/2.0.1/discourse-relationships.owl> ;
    rdfs:isDefinedBy spec:normalization ;
    skos:changeNote "Reused SWAN declaration and structural axioms, without endpoint restrictions."@en .

swandr:referencesAsInconsistentEvidence a owl:ObjectProperty ;
    rdfs:subPropertyOf swandr:refersTo ;
    dcterms:source <https://raw.githubusercontent.com/pav-ontology/swan-ontology/2.0.1/discourse-relationships.owl> ;
    rdfs:isDefinedBy spec:normalization ;
    skos:changeNote "Reused SWAN declaration and structural axioms, without endpoint restrictions."@en .

swandr:motivates a owl:ObjectProperty ;
    rdfs:subPropertyOf swandr:refersTo ;
    dcterms:source <https://raw.githubusercontent.com/pav-ontology/swan-ontology/2.0.1/discourse-relationships.owl> ;
    rdfs:isDefinedBy spec:normalization ;
    skos:changeNote "Reused SWAN declaration and structural axioms, without endpoint restrictions."@en .

swandr:arisesFrom a owl:ObjectProperty ;
    rdfs:subPropertyOf swandr:refersTo ;
    dcterms:source <https://raw.githubusercontent.com/pav-ontology/swan-ontology/2.0.1/discourse-relationships.owl> ;
    rdfs:isDefinedBy spec:normalization ;
    skos:changeNote "Reused SWAN declaration and structural axioms, without endpoint restrictions."@en .

swandr:respondsTo a owl:ObjectProperty ;
    rdfs:subPropertyOf swandr:refersTo ;
    dcterms:source <https://raw.githubusercontent.com/pav-ontology/swan-ontology/2.0.1/discourse-relationships.owl> ;
    rdfs:isDefinedBy spec:normalization ;
    skos:changeNote "Reused SWAN declaration and structural axioms, without endpoint restrictions."@en .

swandr:respondsNeutrallyTo a owl:ObjectProperty ;
    rdfs:subPropertyOf swandr:respondsTo ;
    dcterms:source <https://raw.githubusercontent.com/pav-ontology/swan-ontology/2.0.1/discourse-relationships.owl> ;
    rdfs:isDefinedBy spec:normalization ;
    skos:changeNote "Reused SWAN declaration and structural axioms, without endpoint restrictions."@en .

swandr:respondsPositivelyTo a owl:ObjectProperty ;
    rdfs:subPropertyOf swandr:respondsTo ;
    dcterms:source <https://raw.githubusercontent.com/pav-ontology/swan-ontology/2.0.1/discourse-relationships.owl> ;
