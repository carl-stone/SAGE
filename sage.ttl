swandr:inconsistentWith a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:subPropertyOf swandr:relatesTo ;
    dcterms:source <https://raw.githubusercontent.com/pav-ontology/swan-ontology/2.0.1/discourse-relationships.owl> ;
    rdfs:isDefinedBy spec:normalization ;
    skos:changeNote "Reused SWAN declaration and structural axioms, without endpoint restrictions."@en .

swandr:consistentWith a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:subPropertyOf swandr:relatesTo ;
    dcterms:source <https://raw.githubusercontent.com/pav-ontology/swan-ontology/2.0.1/discourse-relationships.owl> ;
